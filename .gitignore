# Python environment and cache
.venv/
__pycache__/
*.py[cod]
build/
dist/
*.spec

# Local credentials and machine-specific configuration
.env
.env.*
!.env.example
publisher_data/
ai_dubber_jobs.sqlite3
ai_dubber_jobs.sqlite3-wal
ai_dubber_jobs.sqlite3-shm

# Local media and generated work; keep users' files out of source control
uploads/*
!uploads/.gitkeep
audio_segments/*
!audio_segments/.gitkeep
outputs/*
!outputs/.gitkeep

# Angular dependencies and cache
frontend/node_modules/
frontend/.angular/
frontend/dist/

# Logs and temporary files
*.log
*.part
*.upload
